{
    "name": "@course-booking/api",
    "version": "1.0.0",
    "main": "./src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "debug": "DEBUG=express:* node src/index.ts",
        "start": "node dist/index.js",
        "schemathesis": "node ./tests/helpers/run-schemathesis.js",
        "pretest:fuzz:cache-db": "node ./tests/helpers/cache-mongo-binary.js",
        "pretest:fuzz:start": "node ./tests/helpers/run-st-test-server.js",
        "test:unit": "jest --passWithNoTests \\.unit\\.test\\.js$",
        "test:integration": "jest --passWithNoTests --detectOpenHandles \\.integration\\.test\\.js$",
        "test:fuzz": "start-server-and-test pretest:fuzz:start http://localhost:4000 schemathesis",
        "test:all": "npm run test:unit && npm run test:integration && npm run test:fuzz"
    },
    "keywords": [],
    "author": "Tim Leobert Villacin",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-zod-api": "^27.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.18.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "jest": "^25.0.0",
        "jest-junit": "^17.0.0",
        "jest-openapi": "^0.14.1",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "start-server-and-test": "^3.0.8",
        "supertest": "^7.2.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "yamljs": "^0.3.0"
    },
    "peerDependencies": {
        "zod": "~4.3.4"
    },
    "overrides": {
        "axios": "^1.7.0"
    }
